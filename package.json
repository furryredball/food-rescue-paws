{
  "name": "food-rescue-paws",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://furryredball.github.io/food-rescue-paws/",
  "scripts": {
    "dev": "vite",
    "check-content": "node scripts/check-content.mjs",
    "build": "npm run check-content && tsc -b && vite build",
    "build:gh-pages": "npm run check-content && tsc -b && BASE_PATH=/food-rescue-paws/ vite build",
    "build:release": "REQUIRE_REVIEWED_CONTENT=1 npm run check-content && tsc -b && BASE_PATH=/food-rescue-paws/ VITE_REQUIRE_REVIEWED=1 vite build",
    "preview:gh-pages": "npm run build:gh-pages && vite preview",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
